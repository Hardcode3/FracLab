<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.jfractals.ui.settings.SettingsDialogController"
      stylesheets="@SettingsDialog.css"
      styleClass="settings-root"
      prefWidth="430" minWidth="400">
    <VBox styleClass="settings-hero" spacing="5">
        <Label text="FRACLAB  /  CONFIGURATION" styleClass="settings-eyebrow"/>
        <Label text="Fractal settings" styleClass="settings-title"/>
        <Label text="Shape the details of your next exploration." styleClass="settings-subtitle"/>
    </VBox>

    <VBox styleClass="settings-content" spacing="12">
        <GridPane hgap="14" vgap="12" styleClass="settings-form">
            <columnConstraints>
                <ColumnConstraints minWidth="145" hgrow="NEVER"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Fractal" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="typeChoice" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Maximum iterations" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Spinner fx:id="maxIterationsSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Escape radius" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Spinner fx:id="escapeRadiusSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Smooth coloring" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <CheckBox fx:id="smoothCheckBox" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Exponent" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Spinner fx:id="exponentSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Julia real constant" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Spinner fx:id="juliaRealSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="Julia imaginary constant" styleClass="field-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <Spinner fx:id="juliaImagSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        </GridPane>
        <HBox styleClass="settings-note" spacing="9" alignment="CENTER_LEFT">
            <Label text="i" styleClass="note-icon"/>
            <Label text="Changes apply as you adjust the settings." styleClass="note-text" wrapText="true"/>
        </HBox>
    </VBox>
</VBox>
