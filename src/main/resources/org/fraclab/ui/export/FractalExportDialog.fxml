<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.fraclab.ui.export.FractalExportDialogController"
      stylesheets="@../Dialog.css, @FractalExportDialog.css"
      styleClass="dialog-root, export-root"
      spacing="0" prefWidth="470" minWidth="440">
    <VBox styleClass="dialog-hero" spacing="5">
        <Label text="FRACLAB  /  IMAGE EXPORT" styleClass="dialog-eyebrow"/>
        <Label text="Export a fractal" styleClass="dialog-title"/>
        <Label text="Choose a destination, image size, and format." styleClass="dialog-subtitle"/>
    </VBox>

    <VBox styleClass="dialog-content, export-content" spacing="12" maxWidth="Infinity">
        <VBox styleClass="dialog-card, export-card" spacing="10">
            <Label text="Save location" styleClass="section-title"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="exportPathTextField"
                           promptText="Choose a destination"
                           styleClass="export-path-field"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Browse…" onAction="#onBrowseClicked" minWidth="84" styleClass="browse-button"/>
            </HBox>
        </VBox>

        <VBox styleClass="dialog-card, export-card" spacing="12">
            <Label text="Image properties" styleClass="section-title"/>
            <GridPane hgap="12" vgap="12" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints minWidth="118"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Image width (px)" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Spinner fx:id="widthSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
                <Label text="Image height (px)" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="heightSpinner" editable="true" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
                <Label text="Aspect ratio" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <HBox spacing="8" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <Spinner fx:id="aspectRatioWidthSpinner" editable="true" minWidth="70" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Label text="×" styleClass="ratio-separator"/>
                    <Spinner fx:id="aspectRatioHeightSpinner" editable="true" minWidth="70" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </GridPane>
        </VBox>

        <VBox styleClass="dialog-card, export-card" spacing="8">
            <Label text="Image format" styleClass="section-title"/>
            <ComboBox fx:id="imageFormatCombo" maxWidth="Infinity"/>
        </VBox>

        <HBox styleClass="export-footer" spacing="12" alignment="CENTER_LEFT" maxWidth="Infinity">
            <Label fx:id="exportStatus"
                   text="Waiting for export instructions. Idle."
                   styleClass="export-status"
                   wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="exportButton"
                    text="Export image"
                    defaultButton="true"
                    minWidth="112"
                    onAction="#onExportClicked"
                    styleClass="primary-button, export-button"/>
        </HBox>
    </VBox>
</VBox>
