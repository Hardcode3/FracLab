<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.fraclab.ui.navigation.GoToPositionDialogController"
      stylesheets="@../Dialog.css, @GoToPositionDialog.css"
      styleClass="dialog-root, position-root"
      prefWidth="460" minWidth="430">
    <VBox styleClass="dialog-hero" spacing="5">
        <Label text="FRACLAB  /  NAVIGATION" styleClass="dialog-eyebrow"/>
        <Label text="Go to a position" styleClass="dialog-title"/>
        <Label text="Enter the center and zoom shared with you." styleClass="dialog-subtitle"/>
    </VBox>

    <VBox styleClass="dialog-content" spacing="13">
        <GridPane styleClass="dialog-card" hgap="14" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="125" hgrow="NEVER"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Real center" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="centerRealField" promptText="For example, -0,1011 or -0.1011" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Imaginary center" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="centerImaginaryField" promptText="For example, 0,9563 or 0.9563" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Zoom factor" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="zoomFactorField" promptText="1.0 is the default view" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox styleClass="dialog-note" spacing="9" alignment="CENTER_LEFT">
            <Label text="i" styleClass="note-icon"/>
            <Label text="Use a comma or period for decimals. Spaces are ignored."
                   styleClass="note-text" wrapText="true"/>
        </HBox>

        <Label fx:id="validationMessage"
               styleClass="validation-message"
               wrapText="true"
               visible="false"
               minHeight="32"
               prefHeight="32"
               maxHeight="32"/>

        <HBox spacing="9" alignment="CENTER_RIGHT" styleClass="position-actions">
            <Button text="Cancel" onAction="#cancel" cancelButton="true" styleClass="cancel-button"/>
            <Button text="Go to position" onAction="#goToPosition" defaultButton="true" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
